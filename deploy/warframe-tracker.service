[Unit]
Description=Warframe Prime Tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/warframe-tracker
Environment=TRACKER_DB=/opt/warframe-tracker/data/tracker.db
ExecStart=/opt/warframe-tracker/.venv/bin/uvicorn app.main:app --app-dir backend --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
